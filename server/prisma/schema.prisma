// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  bannerUrl    String?
  about        String?
  status       String    @default("ONLINE")
  avatarSize   Int       @default(72)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notebooks    Notebook[]
  notes        Note[]
  tasks        Task[]
  events       Event[]
  studySessions StudySession[]
  journalEntries JournalEntry[]
  mindMapNodes MindMapNode[]
  reminderCompletions ReminderCompletion[]
  sentFriendships Friendship[] @relation("FriendRequester")
  receivedFriendships Friendship[] @relation("FriendReceiver")
  sentMessages ChatMessage[] @relation("MessageSender")
  receivedMessages ChatMessage[] @relation("MessageReceiver")
}

model Notebook {
  id        String   @id @default(cuid())
  title     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes     Note[]
}

model Note {
  id         String   @id @default(cuid())
  title      String   @default("Untitled note")
  content    String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebookId String?
  notebook   Notebook? @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum TaskStatus {
  TODO
  WORKING
  STUCK
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id        String       @id @default(cuid())
  title     String
  note      String?
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    TaskStatus   @default(TODO)
  priority  TaskPriority @default(MEDIUM)
  dueDate   DateTime?
  isFocus   Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Event {
  id        String    @id @default(cuid())
  title     String
  note      String?
  startsAt  DateTime
  endsAt    DateTime?
  color     String?
  visibility String    @default("PRIVATE")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model StudySession {
  id        String   @id @default(cuid())
  title     String   @default("Study session")
  minutes   Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model JournalEntry {
  id        String   @id @default(cuid())
  title     String   @default("Journal entry")
  content   String
  mood      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MindMapNode {
  id        String   @id @default(cuid())
  label     String
  note      String?
  parentId  String?
  color     String   @default("green")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReminderCompletion {
  id          String   @id @default(cuid())
  sourceType  String
  sourceId    String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([sourceType, sourceId, userId])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  receiverId  String
  requester   User     @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User     @relation("FriendReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([requesterId, receiverId])
}

model ChatMessage {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  sender     User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User      @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
}
